@echo off
title 手势花朵本地服务器

rem ============================================================================
rem  指尖花开 · 一键启动本地服务器
rem ----------------------------------------------------------------------------
rem  作用：
rem    1. 切到本脚本所在目录（无论从哪里双击都能正确工作）
rem    2. 检查 Python 与 5500 端口是否可用
rem    3. 延迟 2 秒后用系统默认浏览器打开 http://localhost:5500
rem    4. 前台运行 python -m http.server 5500（关闭窗口即停止服务）
rem
rem  说明：本项目依赖已放在 vendor\ 目录，无需联网。
rem        但摄像头 API 属于安全上下文，必须通过 http://localhost 访问，
rem        直接双击 index.html（file://）会被浏览器禁用摄像头。
rem ============================================================================

rem 用 UTF-8 代码页，保证下面中文提示在 cmd 窗口里不乱码
chcp 65001 >nul

rem 强制切换到脚本所在目录（末尾反斜杠不能省，否则含空格的路径会出错）
cd /d "%~dp0"

echo.
echo   正在启动手势花朵，请稍候...
echo.

rem ---------------------------------------------------------------------------
rem  环境检查：没有 Python 就没法起服务，提前说清楚，别让用户对着黑窗口发呆
rem ---------------------------------------------------------------------------
set "PY_CMD="
where python >nul 2>nul && set "PY_CMD=python"
if not defined PY_CMD (
  where py >nul 2>nul && set "PY_CMD=py"
)

if not defined PY_CMD (
  echo   [错误] 没有检测到 Python。
  echo.
  echo   请先安装 Python 并勾选 "Add Python to PATH"，或改用其他方式起服务，例如：
  echo       npx serve -l 5500
  echo.
  goto :the_end
)

rem ---------------------------------------------------------------------------
rem  端口检查：5500 被占用的话，http.server 会启动失败，
rem  而浏览器仍然会被打开、看到一个打不开的页面，反而更让人困惑
rem ---------------------------------------------------------------------------
netstat -ano | findstr /r /c:":5500 .*LISTENING" >nul 2>nul
if not errorlevel 1 (
  echo   [提示] 端口 5500 已被占用，服务可能无法启动。
  echo          如果是上一次的窗口没关，请先关闭它再重试。
  echo.
)

echo   服务地址： http://localhost:5500
echo   按 Ctrl+C 或直接关闭本窗口即可停止服务器。
echo.

rem ---------------------------------------------------------------------------
rem  延迟 2 秒再打开浏览器：
rem  给 http.server 一点启动时间，避免浏览器比服务器先到而显示"无法访问"
rem  第一个 "" 是 start 的窗口标题占位符，不能省略
rem ---------------------------------------------------------------------------
timeout /t 2 /nobreak >nul
start "" http://localhost:5500

rem ---------------------------------------------------------------------------
rem  前台启动服务器（在脚本所在目录，即项目根目录）
rem  这一行会一直阻塞，直到服务被停止，然后落到下面的 errorlevel 判断
rem ---------------------------------------------------------------------------
%PY_CMD% -m http.server 5500

rem ---------------------------------------------------------------------------
rem  服务器退出（正常 Ctrl+C 或被占用导致失败）后停在这里，方便查看日志
rem ---------------------------------------------------------------------------
echo.
if errorlevel 1 (
  echo   [错误] 服务器未能正常启动，请查看上面的错误信息。
  echo          常见原因：端口 5500 被占用，或 Python 安装不完整。
) else (
  echo   服务器已停止。
)

:the_end
echo.
pause
